[Unit]
Description=Vakt Linux resource monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=vakt
ConfigurationDirectory=vakt
ExecStart=/usr/local/bin/vakt run --config /etc/vakt/config.yaml
Restart=always
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/

[Install]
WantedBy=multi-user.target
